{
  "name": "openai-plus-vxt",
  "description": "ChatGPT registration assistant extension",
  "private": true,
  "version": "0.0.37",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome",
    "dev:manual": "wxt build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-debug-chrome.ps1",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "package:saved-payment": "node scripts/package-saved-payment-release.mjs",
    "compile": "tsc --noEmit",
    "test:payment-runner": "tsx --test tests/payment-runner.test.ts",
    "test:probe-readiness": "tsx --test tests/probe-readiness.test.ts",
    "test:checkout-pipeline": "tsx --test tests/checkout-pipeline.test.ts",
    "test:auth-cf": "tsx --test tests/auth-cf-recovery.test.ts",
    "test:hosted-resolution": "tsx --test tests/hosted-resolution.test.ts",
    "test:saved-payment-methods": "tsx --test tests/saved-payment-methods.test.ts",
    "test:saved-payment-backend": "node --test tests/saved-payment-test-backend.test.mjs",
    "test:e2e-auth-exit": "node scripts/e2e-auth-exit-rotation.mjs",
    "test:e2e-proxy-stages": "node scripts/e2e-proxy-stages.mjs",
    "test:e2e-saved-payment": "node scripts/e2e-saved-payment-live.mjs",
    "test:e2e-saved-payment:check": "node scripts/e2e-saved-payment-live.mjs --check",
    "test:e2e-saved-payment:profile": "node scripts/e2e-saved-payment-live.mjs --probe-profile",
    "test:e2e-plus-closure": "node scripts/e2e-plus-checkout-closure-fixture.mjs",
    "test:e2e-operations-console": "node scripts/e2e-operations-console.mjs",
    "test:e2e-terminal-boundary": "node tests/support/e2e-extension-terminal-boundary.mjs",
    "test:ssot": "tsx --test tests/ssot-consistency.test.ts",
    "test:structural-baseline": "tsx --test tests/structural-baseline.test.ts",
    "test:e2e-plus-closure:live": "tsx scripts/e2e-plus-checkout-closure-live.ts",
    "test:e2e-plus-closure:seal": "tsx scripts/e2e-plus-checkout-closure-live.ts --seal-existing",
    "test:live-readiness": "node --test tests/live-readiness-audit.test.mjs",
    "audit:live": "node scripts/live-readiness-audit.mjs",
    "audit:live:strict": "node scripts/live-readiness-audit.mjs --strict",
    "audit:live:xray": "node scripts/live-readiness-xray-runner.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.26"
  }
}
